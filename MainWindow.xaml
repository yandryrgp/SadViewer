<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SadViewer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="SadViewer.MainWindow"
        Title="SAD Viewer"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F22"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#E6E6E6">

    <Window.Resources>


        <!-- Paleta -->
        <SolidColorBrush x:Key="Bg0"     Color="#1E1F22"/>
        <SolidColorBrush x:Key="Bg1"     Color="#2B2D31"/>
        <SolidColorBrush x:Key="Bg2"     Color="#313338"/>
        <SolidColorBrush x:Key="BorderC" Color="#3F4147"/>
        <SolidColorBrush x:Key="Fg0"     Color="#E6E6E6"/>
        <SolidColorBrush x:Key="FgDim"   Color="#9AA0A6"/>
        <SolidColorBrush x:Key="Accent"  Color="#5865F2"/>
        <SolidColorBrush x:Key="AccentH" Color="#4752C4"/>
        <SolidColorBrush x:Key="Green"   Color="#3BA55D"/>
        <SolidColorBrush x:Key="Red"     Color="#ED4245"/>

        <!-- Card -->
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background"      Value="{StaticResource Bg1}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderC}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- TextBox compacto -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background"               Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground"               Value="{StaticResource Fg0}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderC}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="6,3"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Height"                   Value="26"/>
            <Setter Property="CaretBrush"               Value="{StaticResource Fg0}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox compacto -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background"      Value="{StaticResource Bg2}"/>
            <Setter Property="Foreground"      Value="{StaticResource Fg0}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderC}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="IsEditable"      Value="True"/>
        </Style>

        <!-- Botón base -->
        <Style x:Key="BtnBase" TargetType="{x:Type Button}">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="{StaticResource Bg2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor"  Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>

        <Style x:Key="BtnGhost" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource Fg0}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderC}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Bg2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox de bloques -->
        <Style x:Key="BlocksList" TargetType="{x:Type ListBox}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Padding"    Value="10,8"/>
                        <Setter Property="Margin"     Value="0,2"/>
                        <Setter Property="Foreground" Value="{StaticResource Fg0}"/>
                        <Setter Property="Cursor"     Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg2}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{StaticResource Fg0}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderC}"/>
            <Setter Property="RowBackground"            Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#26282C"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="RowHeight"                Value="30"/>
            <Setter Property="ColumnHeaderHeight"       Value="32"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="CanUserResizeRows"        Value="False"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
            <Setter Property="EnableRowVirtualization"  Value="True"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background"       Value="{StaticResource Bg1}"/>
            <Setter Property="Foreground"       Value="{StaticResource FgDim}"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderC}"/>
            <Setter Property="BorderThickness"  Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fila: Output destacada -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2C31"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsOutputType}" Value="True">
                    <Setter Property="Background" Value="#232A35"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>



    <!-- Atajos de teclado -->
    <Window.InputBindings>
        <KeyBinding Key="F5"    Command="{Binding ConnectCommand}"/>
        <KeyBinding Key="F5"  Modifiers="Shift" Command="{Binding DisconnectCommand}"/>
        <KeyBinding Key="F6"    Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="S"   Modifiers="Ctrl"  Command="{Binding SaveConfigCommand}"/>
        <KeyBinding Key="O"   Modifiers="Ctrl"  Command="{Binding BrowseHrlCommand}"/>
        <KeyBinding Key="F"   Modifiers="Ctrl"  Command="{Binding ClearFilterCommand}"/>
    </Window.InputBindings>

    <!-- ======================= LAYOUT ======================= -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
            <RowDefinition Height="Auto"/>
            <!-- Log -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ============ 1) TOOLBAR ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding + estado -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Accent}"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="SAD" FontWeight="Bold" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SAD Viewer" FontWeight="Bold" FontSize="13"/>
                        <Border Background="{Binding StatusBadgeBg}" CornerRadius="999" Padding="6,1" Margin="0,2,0,0"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding StatusBadgeFg}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- COM -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="COM" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="90" ItemsSource="{Binding AvailablePorts}"
                              Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Puerto serie"/>
                    <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource BtnGhost}" Padding="8,4" Margin="4,0,0,0"
                            ToolTip="Refrescar puertos"
                            Command="{Binding RefreshPortsCommand}"/>
                </StackPanel>

                <!-- Baudios -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Baudios" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="90" ItemsSource="{Binding AvailableBaunds}"
                              Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Velocidad en baudios"/>
                </StackPanel>

                <!-- Acciones BD -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding LoadDatabaseCommand}" ToolTip="Cargar BD (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                            <TextBlock Text="Cargar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Conectar / Desconectar -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding ConnectCommand}" ToolTip="Conectar (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                            <TextBlock Text="Conectar"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding DisconnectCommand}" Margin="6,0,0,0" ToolTip="Desconectar (Shift+F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                            <TextBlock Text="Desconectar"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding RefreshCommand}" Margin="6,0,0,0" ToolTip="Refrescar (F6)">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>

                <!-- Guardar / HRL / GHT en compacto -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding BrowseHrlCommand}" ToolTip="Buscar HRL (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                            <TextBlock Text="HRL"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding BrowseGhtCommand}" Margin="6,0,0,0" ToolTip="Buscar GHT">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                            <TextBlock Text="GHT"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Command="{Binding SaveConfigCommand}" Margin="6,0,0,0" ToolTip="Guardar config (Ctrl+S)">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}"
        Command="{Binding ExportarCommand}"
        ToolTip="Exportar script (Ctrl+P)"
        Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text='[' FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="1,0" VerticalAlignment="Center"/>
                            <TextBlock Text="]" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Spinner -->
                <ProgressBar Grid.Column="7" Width="110" Height="3"
                             IsIndeterminate="True"
                             Foreground="{StaticResource Accent}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- ============ CONTENIDO ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bloques -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding HrlFileNameWithoutExt, StringFormat='SAD: {0}'}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Text="BLOQUES" Style="{StaticResource CardTitle}"/>
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Blocks}"
                             SelectedItem="{Binding SelectedBlock}"
                             DisplayMemberPath="Name"
                             Style="{StaticResource BlocksList}"/>
                </Grid>
            </Border>

            <!-- Piezas -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Buscador + contador -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="PIEZAS" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
                        <Border Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="24,3,6,3"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Margin="8,0,0,0" Foreground="{StaticResource FgDim}"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Buscar pieza… (Ctrl+F)" VerticalAlignment="Center"
                                           Margin="26,0,0,0" Foreground="{StaticResource FgDim}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Filter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{StaticResource FgDim}" FontSize="11"><Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text=" "/><Run Text="/"/><Run Text=" "/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" "/><Run Text="piezas"/></TextBlock>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PiecesView}"
                              SelectedItem="{Binding SelectedPiece, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <!-- Candado -->
                            <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LockGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource FgDim}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   ToolTip="Candado = solo lectura"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Nombre -->
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>

                            <!-- Tipo -->
                            <DataGridTextColumn Header="TIPO" Binding="{Binding TypeText}" IsReadOnly="True" Width="80"/>

                            <!-- Valor (editable solo Output+Conectado) -->
                            <DataGridTextColumn Header="VALOR"
                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                Width="80">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="{x:Type DataGridCell}">
                                        <!--<Setter Property="IsReadOnly" Value="True"/>-->
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsOutputType}" Value="True"/>
                                                    <Condition Binding="{Binding IsConnected}"  Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <!--<Setter Property="IsReadOnly" Value="False"/>-->
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <!-- Anterior -->
                            <DataGridTextColumn Header="ANTERIOR" Binding="{Binding PreviousValue}" IsReadOnly="True" Width="80"/>

                            <!-- Δ -->
                            <DataGridTextColumn Header="Δ" Binding="{Binding Delta}" IsReadOnly="True" Width="60"/>

                            <!-- Default -->
                            <DataGridTextColumn Header="DEFAULT" Binding="{Binding DefaultValue}" IsReadOnly="True" Width="80"/>

                            <!-- Handle -->
                            <DataGridTextColumn Header="HANDLE" Binding="{Binding HandleHex}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 7) LOG con niveles ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" MaxHeight="170">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de log -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="LOG" Style="{StaticResource CardTitle}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <CheckBox Grid.Column="1" Content="INFO" IsChecked="{Binding ShowInfo}" Foreground="{StaticResource FgDim}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="2" Content="OK"   IsChecked="{Binding ShowOk}"   Foreground="{StaticResource Green}"  Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="3" Content="WARN" IsChecked="{Binding ShowWarn}" Foreground="#F0B232"                Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="4" Content="ERR"  IsChecked="{Binding ShowErr}"  Foreground="{StaticResource Red}"    Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <TextBox Grid.Column="5" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtrar líneas de log" Margin="4,0,8,0"/>

                    <Button Grid.Column="6" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource BtnGhost}" Padding="8,4" Margin="0,0,6,0"
                            ToolTip="Copiar log" Command="{Binding CopyLogCommand}"/>
                    <Button Grid.Column="7" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource BtnGhost}" Padding="8,4" Margin="0,0,6,0"
                            ToolTip="Limpiar log" Command="{Binding ClearLogCommand}"/>
                    <TextBlock Grid.Column="8" VerticalAlignment="Center" Foreground="{StaticResource FgDim}" FontSize="11"><Run Text="Errores:"/><Run Text=" "/><Run Text="{Binding ErrorCount, Mode=OneWay}" Foreground="{StaticResource Red}"/></TextBlock>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredLogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontSize="11"
                                           TextWrapping="Wrap"><Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#6E7681"/><Run Text=" "/><Run Text=" "/><Run Text=" "/><Run Text="{Binding LevelText, Mode=OneWay}"
                                         FontWeight="Bold"
                                         Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}"/><Run Text=" "/><Run Text=" "/><Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}"
                                         Foreground="{StaticResource Fg0}"/></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ 3) STATUS BAR inferior ============ -->
        <Border Grid.Row="3" Background="{StaticResource Bg1}" CornerRadius="8"
                Padding="10,5" Margin="0,8,0,0"
                BorderBrush="{StaticResource BorderC}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="·" Margin="10,0" Foreground="{StaticResource FgDim}" FontSize="11"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ComPort}" FontSize="11" Foreground="{StaticResource FgDim}"/>
                    <TextBlock Text=" @ " FontSize="11" Foreground="{StaticResource FgDim}"/>
                    <TextBlock Text="{Binding BaudRate}" FontSize="11" Foreground="{StaticResource FgDim}"/>
                </StackPanel>

                <TextBlock Grid.Column="4" FontSize="11" Foreground="{StaticResource FgDim}"
                           VerticalAlignment="Center" Margin="0,0,14,0"><Run Text="Últ. refresco:"/><Run Text=" "/><Run Text="{Binding LastRefreshText, Mode=OneWay}"/></TextBlock>

                <TextBlock Grid.Column="5" FontSize="11" Foreground="{StaticResource FgDim}"
                           VerticalAlignment="Center"><Run Text="v1.0 · libSad 2.7.2"/></TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>